        reservations:
          devices:
            - driver: nvidia
              count: ${GPU_COUNT:-2}
              capabilities: [gpu, compute, utility]
        limits:
          cpus: ${CPU_LIMIT:-16}
          memory: ${MEMORY_LIMIT:-64G}
    healthcheck:
      test: ["CMD", "python", "-c", "from core.system_monitor import SystemMonitor; import asyncio; monitor = SystemMonitor(); asyncio.run(monitor.health_check())"]
      interval: 30s
      timeout: 30s
      retries: 3
      start_period: 60s
    labels:
      - "com.quenne.description=QUENNE-STARSHIP AI Main Service"
      - "com.quenne.version=${VERSION:-latest}"
      - "com.quenne.maintainer=Dr. Nicolas Santiago <safewayguardian@gmail.com>"

  # Database for system state
  postgres:
