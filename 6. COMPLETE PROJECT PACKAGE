    volumes:
      - ./data:/app/data
      - ./logs:/app/logs
      - ./config:/app/config
      - ./quantum_states:/app/quantum_states
      - ./neural_patterns:/app/neural_patterns
      - ./backups:/app/backups
      - /tmp:/app/temp
    ports:
      - "8080:8080"  # Dashboard
      - "9090:9090"  # API
      - "7070:7070"  # Quantum
