    container_name: quenne-database
    restart: unless-stopped
    environment:
      POSTGRES_DB: quenne
      POSTGRES_USER: quenne
      POSTGRES_PASSWORD: ${DB_PASSWORD:-quantum_exploration}
      POSTGRES_INITDB_ARGS: "--encoding=UTF-8 --lc-collate=C --lc-ctype=C"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./deployment/database/init.sql:/docker-entrypoint-initdb.d/init.sql
    ports:
      - "5432:5432"
    networks:
      - quenne-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U quenne -d quenne"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: '2'
          memory: 4G

  # Redis for caching and queue
  redis:
    image: redis:7-alpine
    container_name: quenne-redis
    restart: unless-stopped
    command: redis-server --appendonly yes --requirepass ${REDIS_PASSWORD:-quantum_cache}
    volumes:
      - redis_data:/data
    ports:
      - "6379:6379"
    networks:
      - quenne-network
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD:-quantum_cache}", "ping"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 2G

  # Monitoring with Grafana
