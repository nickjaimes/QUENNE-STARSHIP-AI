# QUENNE-STARSHIP AI Docker Container
# Multi-stage build for quantum-neuromorphic computing environment

# Stage 1: Base image with CUDA support
FROM nvidia/cuda:12.2.0-devel-ubuntu22.04 AS base

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV CUDA_VISIBLE_DEVICES=all

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    python3-dev \
    python3-venv \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    libopenmpi-dev \
    libfftw3-dev \
    libhdf5-dev \
    libblas-dev \
    liblapack-dev \
    libopenblas-dev \
    libatlas-base-dev \
    libeigen3-dev \
    libboost-all-dev \
    libgmp-dev \
    libmpfr-dev \
    libmpc-dev \
    libssl-dev \
    libffi-dev \
    libncurses5-dev \
    libreadline-dev \
    libsqlite3-dev \
    libbz2-dev \
    liblzma-dev \
    tk-dev \
    libgdbm-dev \
    libgdbm-compat-dev \
    libnss3-dev \
    libgtk-3-dev \
    libgl1-mesa-glx \
    libgl1-mesa-dri \
    libglu1-mesa-dev \
    freeglut3-dev \
    mesa-common-dev \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.10 as default
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1
RUN update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1

# Create non-root user
RUN useradd -m -u 1000 -s /bin/bash quenne
USER quenne
WORKDIR /home/quenne

# Stage 2: Quantum computing environment
FROM base AS quantum-env

# Install quantum computing dependencies
RUN pip install --no-cache-dir \
    qiskit==2.0.0 \
    qiskit-aer==0.12.0 \
    qiskit-ibm-runtime==0.20.0 \
    qiskit-qec==0.2.0 \
    cirq==1.2.0 \
    pennylane==0.32.0 \
    tensorflow-quantum==0.7.0 \
    qutip==4.7.0 \
    strawberryfields==0.26.0

# Install CUDA quantum extensions
RUN pip install --no-cache-dir \
    cuda-quantum==0.5.0 \
    nvidia-quantum==1.0.0 \
    torch-cuda==2.1.0

# Stage 3: Neuromorphic computing environment
FROM quantum-env AS neuromorphic-env

# Install neuromorphic computing dependencies
RUN pip install --no-cache-dir \
    nengo==3.2.0 \
    snntorch==0.6.0 \
    lava-nc==0.7.0 \
    torch==2.1.0 \
    torchvision==0.16.0 \
    torchaudio==2.1.0

# Stage 4: Application environment
FROM neuromorphic-env AS app-env

# Create application directory
WORKDIR /app

# Copy requirements
COPY requirements.txt .
COPY requirements-dev.txt .

# Install application dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Install development dependencies (optional)
ARG INSTALL_DEV=false
RUN if [ "$INSTALL_DEV" = "true" ]; then pip install --no-cache-dir -r requirements-dev.txt; fi

# Copy application code
COPY --chown=quenne:quenne . .

# Create necessary directories
RUN mkdir -p \
    /app/data \
    /app/logs \
    /app/simulations \
    /app/quantum_states \
    /app/neural_patterns \
    /app/backups \
    /app/temp

# Set permissions
RUN chown -R quenne:quenne /app
RUN chmod -R 755 /app

# Set environment variables
ENV QUANTUM_BACKEND="aer_simulator"
ENV NEUROMORPHIC_MODE="simulation"
ENV CONSCIOUSNESS_LEVEL="sovereign"
ENV ETHICAL_MODE="strict"
ENV SHIP_NAME="QUENNE-Prototype"
ENV DEPLOYMENT_ENV="container"
ENV LOG_LEVEL="INFO"

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD python -c "from core.system_monitor import SystemMonitor; \
    monitor = SystemMonitor(); \
    import asyncio; \
    asyncio.run(monitor.health_check())"

# Expose ports
EXPOSE 8080  # Web dashboard
EXPOSE 9090  # REST API
EXPOSE 7070  # Quantum control
EXPOSE 6060  # Neuromorphic control
EXPOSE 5050  # Consciousness monitoring
EXPOSE 3000  # Grafana monitoring

# Entry point
ENTRYPOINT ["python", "-m", "core.main"]

# Default command
CMD ["--config", "/app/config/quenne_config.yaml", "--mode", "sovereign"]
