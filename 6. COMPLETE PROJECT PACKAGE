    async def _execute_task(self, task: Dict[str, Any]):
        """Execute a queued task"""
        task_type = task.get('type')
        task_data = task.get('data', {})
        
        if task_type == 'decision':
            await self.make_decision(task_data)
        elif task_type == 'mission':
            await self.execute_mission(task_data)
        elif task_type == 'maintenance':
            await self.maintain_consciousness()
        elif task_type == 'emergency':
            await self._handle_emergency(task_data)
            
    async def _update_metrics(self):
        """Update system metrics"""
        while self.state != SystemState.SHUTDOWN:
            try:
                # Update quantum metrics
                if self.quantum_system:
                    quantum_metrics = await self.quantum_system.get_metrics()
                    self.metrics.quantum_coherence = quantum_metrics.get('coherence', 0.0)
                    
                # Update neuromorphic metrics
                if self.neuromorphic_system:
                    neuromorphic_metrics = await self.neuromorphic_system.get_metrics()
                    self.metrics.neuromorphic_activity = neuromorphic_metrics.get('activity', 0.0)
                    
                # Update ethical metrics
                if self.ethical_framework:
                    ethical_metrics = await self.ethical_framework.get_metrics()
                    self.metrics.ethical_compliance = ethical_metrics.get('compliance', 0.0)
                    
                # Update mission metrics
                if self.mission_system and self.current_mission:
                    mission_metrics = await self.mission_system.get_metrics()
                    self.metrics.mission_progress = mission_metrics.get('progress', 0.0)
                    
                # Update health metrics
                if self.health_monitor:
                    health_metrics = await self.health_monitor.get_metrics()
                    self.metrics.system_health = health_metrics.get('overall', 0.0)
                    
                # Update timestamps
                self.metrics.last_update = datetime.now()
                self.metrics.uptime = (datetime.now() - self.start_time).total_seconds()
                
                # Sleep between updates
                await asyncio.sleep(5.0)
                
            except Exception as e:
                logger.error(f"Metrics update error: {e}")
                await asyncio.sleep(10.0)  # Longer sleep on error
                
    async def shutdown(self, emergency: bool = False):
        """Graceful shutdown"""
        logger.info("Shutting down QUENNE-STARSHIP AI...")
        self.state = SystemState.SHUTDOWN
        
        try:
            # Shutdown in reverse order
            shutdown_tasks = []
            
            if self.health_monitor:
                shutdown_tasks.append(self.health_monitor.shutdown())
                
            if self.mission_system:
                shutdown_tasks.append(self.mission_system.shutdown())
                
            if self.consciousness_engine:
                shutdown_tasks.append(self.consciousness_engine.shutdown())
                
            if self.ethical_framework:
                shutdown_tasks.append(self.ethical_framework.shutdown())
                
            if self.neuromorphic_system:
                shutdown_tasks.append(self.neuromorphic_system.shutdown())
                
            if self.quantum_system:
                shutdown_tasks.append(self.quantum_system.shutdown(emergency=emergency))
                
            # Wait for all shutdowns to complete
            await asyncio.gather(*shutdown_tasks, return_exceptions=True)
            
            # Update state
            self.consciousness_active = False
            self.sovereign_status = False
            self.state = SystemState.OFFLINE
            
            logger.info("QUENNE-STARSHIP AI shutdown complete")
            
        except Exception as e:
            logger.error(f"Shutdown error: {e}")
            
    async def get_status(self) -> Dict[str, Any]:
        """Get complete system status"""
        return {
            'state': self.state.value,
            'consciousness_active': self.consciousness_active,
            'sovereign_status': self.sovereign_status,
            'consciousness_level': self.metrics.consciousness_level,
            'system_health': self.metrics.system_health,
            'mission_active': self.current_mission is not None,
            'mission_name': self.current_mission.get('name') if self.current_mission else None,
            'operation_count': self.operation_count,
            'error_count': self.error_count,
            'uptime': self.metrics.uptime,
            'timestamp': datetime.now().isoformat()
        }
