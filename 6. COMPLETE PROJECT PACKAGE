      - SHIP_NAME=${SHIP_NAME:-QUENNE-Prototype}
      
      # Performance settings
      - QUANTUM_CORES=${QUANTUM_CORES:-7}
      - NEUROMORPHIC_CORES=${NEUROMORPHIC_CORES:-1024}
