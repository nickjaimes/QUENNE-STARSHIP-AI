```python
import asyncio
import aiohttp
import json

class QUENNEClient:
    def __init__(self, base_url="http://localhost:9090"):
        self.base_url = base_url
        self.session = None
        
    async def connect(self):
        self.session = aiohttp.ClientSession()
        
    async def get_status(self):
        async with self.session.get(f"{self.base_url}/api/v1/status") as response:
            return await response.json()
            
    async def make_decision(self, situation):
        async with self.session.post(
            f"{self.base_url}/api/v1/decisions",
            json=situation
        ) as response:
            return await response.json()
            
    async def start_mission(self, mission_config):
        async with self.session.post(
            f"{self.base_url}/api/v1/missions",
            json=mission_config
        ) as response:
            return await response.json()

# Example usage
async def main():
    client = QUENNEClient()
    await client.connect()
    
    # Get system status
    status = await client.get_status()
    print(f"Consciousness level: {status['consciousness_level']}")
    
    # Make a decision
    situation = {
        "type": "navigation_decision",
        "destination": {"name": "Alpha Centauri", "distance": 4.37},
        "crew_count": 120,
        "resources": {"fuel": 85, "power": 92}
    }
    
    decision = await client.make_decision(situation)
    print(f"Decision: {decision['decision']}")
    print(f"Confidence: {decision['confidence']}")
    
    # Start a mission
    mission = {
        "name": "First Contact Protocol",
        "type": "first_contact",
        "alien_signature": {"civilization_type": "Type II"},
        "crew_prepared": True
    }
    
    mission_result = await client.start_mission(mission)
    print(f"Mission status: {mission_result['status']}")

asyncio.run(main())
