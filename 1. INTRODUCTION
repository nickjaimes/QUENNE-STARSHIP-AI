    def _calculate_neural_synchrony(self, outputs: List[List[float]]) -> float:
        """Calculate neural synchronization level"""
        if not outputs:
            return 0.0
            
        # Convert to numpy array
        outputs_array = np.array(outputs)
        
        # Calculate cross-correlation between neurons
        num_neurons = outputs_array.shape[1]
        correlations = []
        
        for i in range(num_neurons):
            for j in range(i+1, num_neurons):
                corr = np.corrcoef(outputs_array[:, i], outputs_array[:, j])[0, 1]
                if not np.isnan(corr):
                    correlations.append(corr)
                    
        return np.mean(correlations) if correlations else 0.0
        
