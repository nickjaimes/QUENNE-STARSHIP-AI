        # Process through network
        output_spikes = []
        network_activity = []
        
        for t in range(time_steps):
            timestep_output = []
            
            for neuron in self.neurons:
                # Calculate input to this neuron
                neuron_input = 0.0
                for (pre, post), synapse in self.synapses.items():
                    if post == neuron.neuron_id:
                        # Check if pre-synaptic neuron spiked
                        pre_spike = 1.0 if t in spike_train.get(pre, []) else 0.0
                        neuron_input += pre_spike * synapse["weight"]
                        
                # Add external input if present
                if t in spike_train.get(-1, []):  # -1 represents external input
                    neuron_input += spike_train[-1][t]
                    
                # Process neuron
                spike = neuron.process(neuron_input)
                timestep_output.append(spike)
                
            output_spikes.append(timestep_output)
            
            # Calculate network metrics
            activity = sum(timestep_output) / len(timestep_output)
            network_activity.append(activity)
            
            # Apply STDP learning
            if t % 10 == 0:  # Learn every 10 timesteps
                await self._apply_stdp(output_spikes, spike_train, t)
                
        # Analyze results
