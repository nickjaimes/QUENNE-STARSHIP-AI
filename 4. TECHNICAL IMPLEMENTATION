        self.learning_rate = learning_rate
        self.plasticity = plasticity
        self.a_plus = 0.01
        self.a_minus = 0.012
        self.tau_plus = 0.02
        self.tau_minus = 0.02
        
    async def initialize(self):
        """Initialize learning engine"""
        logger.info(f"Initializing STDP Learning Engine (rate={self.learning_rate})")
        
    def calculate_update(self, pre_spikes: List[int], 
                        post_spikes: List[int], current_time: int) -> float:
        """Calculate weight update based on spike timing"""
        if not pre_spikes or not post_spikes:
            return 0.0
            
        total_update = 0.0
        
        for t_pre in pre_spikes:
            for t_post in post_spikes:
                delta_t = t_post - t_pre
                
                if delta_t > 0:  # Post after pre: potentiation
                    update = self.a_plus * np.exp(-delta_t / self.tau_plus)
                else:  # Pre after post: depression
                    update = -self.a_minus * np.exp(delta_t / self.tau_minus)
                    
                total_update += update
                
        return total_update * self.learning_rate
